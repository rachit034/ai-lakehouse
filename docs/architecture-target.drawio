<mxfile host="app.diagrams.net"><diagram id="arch" name="ai-lakehouse — Target architecture (local-LLM knowledge graph)"><mxGraphModel dx="1500" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ai-lakehouse — Target architecture (local-LLM knowledge graph)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="T1" value="&lt;b&gt;Clients + identity&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1460" height="140" as="geometry"/></mxCell><mxCell id="t_ui" value="&lt;b&gt;Query console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;NL · graph Q&amp;amp;A · SQL · Cypher&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="t_agents" value="&lt;b&gt;Agents over MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Claude today → local agent model&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;when evals say it&amp;#x27;s ready&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="400" height="80" as="geometry"/></mxCell><mxCell id="t_oidc" value="&lt;b&gt;OIDC identity (Keycloak)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;per-person tokens + groups → roles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="320" height="80" as="geometry"/></mxCell><mxCell id="t_eval" value="&lt;b&gt;Eval suite (CI-gated)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;graph Q&amp;amp;A + NL→SQL cases&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;blocks model/prompt regressions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="340" height="80" as="geometry"/></mxCell><mxCell id="T2" value="&lt;b&gt;Gateway — stateless API, N replicas (no heavy work in requests)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="1460" height="300" as="geometry"/></mxCell><mxCell id="t_policy" value="&lt;b&gt;AuthN/Z + policy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;JWT → role; business reads masked views only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="460" height="60" as="geometry"/></mxCell><mxCell id="t_router" value="&lt;b&gt;Question router + planner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;graph · SQL · vector · or multi-step plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="440" height="60" as="geometry"/></mxCell><mxCell id="t_jobsapi" value="&lt;b&gt;Job API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;submit build/materialize/Silver → job id + status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="280" width="480" height="60" as="geometry"/></mxCell><mxCell id="t_link" value="&lt;b&gt;Entity linking&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vector search maps &amp;#x27;headphones&amp;#x27;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;→ exact node names before&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cypher is written&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="340" height="140" as="geometry"/></mxCell><mxCell id="t_gqa" value="&lt;b&gt;Graph Q&amp;amp;A (local LLM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ontology + schema grounding&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;verified few-shot examples&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;constrained JSON · EXPLAIN check&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;repair loop · read-only · LIMIT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="370" width="380" height="140" as="geometry"/></mxCell><mxCell id="t_sql" value="&lt;b&gt;NL → SQL (local LLM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;metrics layer · literal-safe&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;semantic cache&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read-only guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="370" width="300" height="140" as="geometry"/></mxCell><mxCell id="t_onto" value="&lt;b&gt;Ontology registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;draft → review → active&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;version diff · DataHub glossary&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;descriptions feed Q&amp;amp;A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="370" width="340" height="140" as="geometry"/></mxCell><mxCell id="T3" value="&lt;b&gt;Workers — job queue (arq/Redis), retries, progress&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1460" height="170" as="geometry"/></mxCell><mxCell id="t_w_onto" value="&lt;b&gt;Ontology inference&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;larger local model (14–32B)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;offline, quality over speed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="340" height="110" as="geometry"/></mxCell><mxCell id="t_w_sync" value="&lt;b&gt;Incremental graph sync&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Iceberg snapshot diff → upsert&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;changed rows only; replaces&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;full rebuilds + stale flags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="380" height="110" as="geometry"/></mxCell><mxCell id="t_w_er" value="&lt;b&gt;Silver entity resolution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;blocking + scoring&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;graph-native components (GDS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="620" width="300" height="110" as="geometry"/></mxCell><mxCell id="t_w_embed" value="&lt;b&gt;Embeddings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;batch, resumable&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;node names + descriptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1120" y="620" width="340" height="110" as="geometry"/></mxCell><mxCell id="T4" value="&lt;b&gt;Engines&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="1460" height="200" as="geometry"/></mxCell><mxCell id="t_llm" value="&lt;b&gt;Local LLM server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ollama → vLLM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;small model: Q&amp;amp;A (fast)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;large model: ontology&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="300" height="130" as="geometry"/></mxCell><mxCell id="t_qe" value="&lt;b&gt;Query engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DuckDB (local, 1 user)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Trino / Athena when&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;multi-user&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="830" width="260" height="130" as="geometry"/></mxCell><mxCell id="t_neo" value="&lt;b&gt;Neo4j (+ GDS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;graph + ontologies&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;+ example library&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;≈ Neptune&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="830" width="260" height="130" as="geometry"/></mxCell><mxCell id="t_lance" value="&lt;b&gt;LanceDB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;entity + text vectors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="830" width="240" height="130" as="geometry"/></mxCell><mxCell id="t_obs" value="&lt;b&gt;MLflow + Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;traces, eval runs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;queue, cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="830" width="280" height="130" as="geometry"/></mxCell><mxCell id="T5" value="&lt;b&gt;Data (Iceberg on MinIO/S3 · Gravitino catalog · DataHub governance)&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1460" height="190" as="geometry"/></mxCell><mxCell id="t_bronze" value="&lt;b&gt;Bronze&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;raw tables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="260" height="110" as="geometry"/></mxCell><mxCell id="t_silver" value="&lt;b&gt;Silver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt