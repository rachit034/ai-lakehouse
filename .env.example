# Copy to .env and fill in. Never commit .env.

# MinIO (S3 substitute)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Iceberg catalog PostgreSQL (backs Gravitino)
ICEBERG_PG_USER=iceberg
ICEBERG_PG_PASSWORD=change-me
ICEBERG_PG_DB=iceberg

# Neo4j
NEO4J_PASSWORD=change-me

# LLM served by Ollama on the host
OLLAMA_MODEL=qwen3:4b
# Docker Desktop / Linux: leave unset (defaults to http://host.docker.internal:11434)
# Colima on macOS:        http://192.168.5.2:11434
# OLLAMA_BASE_URL=

# Gateway API auth: one key per role (see gateway/core/auth.py).
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY_DATA_ENGINEER=
API_KEY_DATA_MODELER=
API_KEY_BUSINESS=

# Optional: named per-person/service keys so traces show who called,
# format "name:role:key" comma-separated. Roles: data_engineer, data_modeler, business.
# API_KEYS=alice:business:<key>,etl:data_engineer:<key>
